// ================================================================
// 更新 Inscription 节点编码字段（一级~四级中文编码）
// 匹配依据: id (题记序号)
// ================================================================

LOAD CSV WITH HEADERS FROM 'file:///inscriptions_clean.csv' AS row
MATCH (i:Inscription {id: row.题记序号})
SET i.raw_实践1 = row.`实践行为（一级编码）`,
    i.raw_实践2 = row.`实践行为（二级编码）`,
    i.raw_实践3 = row.`实践行为（三级编码）`,
    i.raw_实践4 = row.`实践行为（四级编码）`,
    i.raw_祈愿1 = row.`祈愿内容（一级编码）`,
    i.raw_祈愿2 = row.`祈愿内容（二级编码）`,
    i.raw_祈愿3 = row.`祈愿内容（三级编码）`,
    i.raw_祈愿4 = row.`祈愿内容（四级编码）`,
    i.raw_原因1 = row.`造像原因（一级编码）`,
    i.raw_原因2 = row.`造像原因（二级编码）`,
    i.raw_原因3 = row.`造像原因（三级编码）`,
    i.raw_原因4 = row.`造像原因（四级编码）`;
